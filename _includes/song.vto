<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/styles/home.css" />
    <link rel="stylesheet" href="/styles/song.css" />
    <link rel="stylesheet" href="/styles/dark-mode.css" />
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" id="theme-color-meta" content="#f5f5f5">
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
    <script src="/client_scripts/main.js"></script>

    <pagefind-config base-url="{{ base }}"></pagefind-config>
    <pagefind-config bundle-path="{{ base }}pagefind/" ></pagefind-config>
    <link rel="icon" href="{{ base }}img/icon-192.png" type="image/png">
    <title> {{ title }}</title>
  </head>
  <body>
  <div class = "search-container">
    <pagefind-modal-trigger></pagefind-modal-trigger>
      <pagefind-modal>
        <pagefind-modal-header>
          <pagefind-input></pagefind-input>
        </pagefind-modal-header>
        <pagefind-modal-body>
          <pagefind-summary></pagefind-summary>
          <pagefind-results>
            <script type="text/pagefind-template">
              {{ pagefindResultTemplate }}
            </script>
          </pagefind-results>
        </pagefind-modal-body>
        <pagefind-modal-footer>
          <pagefind-keyboard-hints></pagefind-keyboard-hints>
        </pagefind-modal-footer>
      </pagefind-modal>


  </div>
  <div class="song-container">
    <div class="song-header">
        <h1 id="song-title">{{ title }}</h1>
        <div id="song-author">{{ author }}</div>
    </div>
    <div class="transpose-controls">
        <button id="transpose-down"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
        <span id="transpose-value">0</span>
        <button id="transpose-up"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
    </div>
    <div id="song-lyrics">
      {{ content }}
    </div>
    </div>
    <button class="dark-mode-toggle" id="darkModeToggle" aria-label="Toggle dark mode">
      <svg id="sunIcon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg id="moonIcon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
    </button>
    <button class="keep-screen-on-toggle" id="keepScreenOnToggle" aria-label="Keep screen on">
      <svg id="keepScreenOnIcon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/></svg>
    </button>
    <script src="/client_scripts/transpose.js" type="module"></script>
    <script src="/client_scripts/searchbar.js" type="module"></script>
  </body>
</html>